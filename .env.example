# ==============================================================================
# Conecta Nexus - Moderation Microservice Environment Configuration
# ==============================================================================

# Database connection URL (PostgreSQL)
# Container network default: postgres:5432
# Local host default: localhost:5432
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/db_moderation

# Django Core Settings
# Use DEBUG=False and a unique cryptographic SECRET_KEY in production.
DEBUG=False
SECRET_KEY=replace-with-unique-cryptographic-secret-key
# Restrict to actual service / proxy hostnames (never '*' in production).
ALLOWED_HOSTS=localhost,127.0.0.1

# Deployment Mount & CSRF Origin Configuration
# Mode A (Standalone /admin/): leave FORCE_SCRIPT_NAME and CSRF_TRUSTED_ORIGINS empty.
# Mode B (Gateway-mounted /services/moderation/admin/):
#   FORCE_SCRIPT_NAME=/services/moderation
#   Local HTTP Gateway: CSRF_TRUSTED_ORIGINS=http://localhost:8080
#   Production HTTPS Gateway: CSRF_TRUSTED_ORIGINS=https://gateway.example.edu.co
FORCE_SCRIPT_NAME=
CSRF_TRUSTED_ORIGINS=

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Cryptographic Public Key for RS256 JWT Verification (ADR-002)
JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem
